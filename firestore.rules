rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Product catalog controlled by makers
    match /products/{productId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.makerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.makerId == request.auth.uid;
    }

    // Shop connection requests from makers
    match /connectionRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.makerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
    }

    // Active shop/maker relationships
    match /connections/{connectionId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create, update, delete: if request.auth != null && (
        request.resource.data.makerId == request.auth.uid ||
        request.resource.data.shopId == request.auth.uid
      );
    }

    // Drop-off consignments and shop inventory actions
    match /consignments/{consignmentId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.makerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
    }

    // Normalized inventory records for accepted consignments
    match /inventory/{inventoryId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create, update, delete: if request.auth != null && (
        request.resource.data.makerId == request.auth.uid ||
        request.resource.data.shopId == request.auth.uid
      );
    }

    // Sales records created by shopkeepers
    match /sales/{saleId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.shopId == request.auth.uid;
      allow update: if request.auth != null && resource.data.shopId == request.auth.uid;
    }

    // Settlement records for payout tracking
    match /settlements/{settlementId} {
      allow read: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.shopId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.makerId == request.auth.uid ||
        resource.data.shopId == request.auth.uid
      );
    }

    // Freelancer gigs and applications
    match /gigs/{gigId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.freelancerId == request.auth.uid ||
        resource.data.requesterId == request.auth.uid
      );
    }

    // Portfolio items for freelancers
    match /portfolios/{portfolioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.data.freelancerId == request.auth.uid;
    }

    // Notification feed for users
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.recipientId == request.auth.uid;
    }
  }
}
